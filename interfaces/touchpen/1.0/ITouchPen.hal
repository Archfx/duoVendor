package vendor.surface.touchpen@1.0;

import @1.0::IPenCallback;
import @1.0::IDisplayTappedCallback;

interface ITouchPen {    
    enum DisplayState : int32_t {
        LEFT,
        RIGHT,
        BOTH,
        NONE
    };

    enum Dexterity : int32_t {
        LEFT_HANDED,
        RIGHT_HANDED,
    };

    oneway setDisplayState(DisplayState state);

    oneway setDexterity(Dexterity dexState);

    oneway setTapToWakeEnable(bool state);

    oneway setInteractive(bool state);
    
    oneway sendPenTailReports(vec<int8_t> report);

    oneway displayOrientation(int32_t orientation);

    registerDisplayTappedCallback(IDisplayTappedCallback callback) generates (bool success);

    unregisterDisplayTappedCallback(IDisplayTappedCallback callback) generates (bool success);

    oneway setSecurityKey(vec<int8_t> key);

    oneway setBluetoothMac(vec<int8_t> mac, int8_t type);

    oneway hingeAngle(int32_t newAngle);

    registerPenCallback(IPenCallback callback) generates (bool success);

    unregisterPenCallback(IPenCallback callback) generates (bool success);
};