android_app_import {
    name: "com.surface.touchpenservice",
    apk: "StubbedTouchPenService.apk",
    
    // Explicitly target the system_ext partition to match stock layout
    system_ext_specific: true,
    
    // Flag it as a privileged background daemon application
    privileged: true,
    
    // Force AOSP to sign it with the platform keys so it has system-level trust
    certificate: "platform",
    
    // Prevent the build system from stripping out pre-optimized code structures
    dex_preopt: {
        enabled: false,
    },
}

prebuilt_etc {
    name: "privapp-permissions-touchpen.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
    src: "privapp-permissions-touchpen.xml",
}