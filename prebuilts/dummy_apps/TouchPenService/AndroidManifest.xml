<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.surface.touchpenservice"
    android:sharedUserId="android.uid.system"
    coreApp="true"> <!-- Matches stock system group context -->

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS"/>
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS_FULL"/>

    <!-- The critical flag that tells Android to auto-restart the app if it ever dies -->
    <application
        android:persistent="true"
        android:label="TouchPen Dummy Service"
        android:defaultToDeviceProtectedStorage="true"
        android:directBootAware="true">

        <!-- Automatically kickstart the app on boot -->
        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- The core background daemon service -->
        <service android:name=".MainDummyService" android:exported="false" />
    </application>
</manifest>